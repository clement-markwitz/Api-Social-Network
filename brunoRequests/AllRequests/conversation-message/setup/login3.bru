}

script:post-response {
  if (res.status === 200 || res.status === 201) {
      bru.setEnvVar("token_userC", res.body.token);
      bru.setEnvVar("id_userC", res.body.id);
      console.log("User C configuré : " + res.body.username);
  }
}
