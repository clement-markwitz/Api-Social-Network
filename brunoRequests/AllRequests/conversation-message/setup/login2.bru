meta {
  name: login2
  type: http
  seq: 4
}

post {
  url: http://localhost:8080/api/auth/login
  body: json
  auth: inherit
}

body:json {
  {
    "username": "alice",
    "password": "password123"
  }
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
      bru.setEnvVar("token_userB", res.body.token);
      bru.setEnvVar("id_userB", res.body.id);
      console.log("User B configuré : " + res.body.username);
  }
}
